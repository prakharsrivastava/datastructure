-- Optional cleanup
DROP TABLE IF EXISTS views, comments, videos, tags, users;
DROP TYPE IF EXISTS platform_enum;

-- Enum for platform
CREATE TYPE platform_enum AS ENUM ('web', 'android', 'ios');

-- USERS
CREATE TABLE users (
    id UUID PRIMARY KEY,
    name VARCHAR(100),
    email VARCHAR(100),
    dob DATE,
    location POINT,
    createdAt TIMESTAMP
);

-- TAGS
CREATE TABLE tags (
    id UUID PRIMARY KEY,
    value VARCHAR(50)
);

-- VIDEOS
CREATE TABLE videos (
    id UUID PRIMARY KEY,
    userID UUID REFERENCES users(id),
    title VARCHAR(255),
    description TEXT,
    thumbnailURL VARCHAR(255),
    streamURL VARCHAR(255),
    tags UUID REFERENCES tags(id),
    uploadedAt TIMESTAMP
);

-- VIEWS
CREATE TABLE views (
    id UUID PRIMARY KEY,
    userID UUID REFERENCES users(id),
    videoID UUID REFERENCES videos(id),
    offset INT,
    platform platform_enum,
    createdAt TIMESTAMP
);

-- COMMENTS
CREATE TABLE comments (
    id UUID PRIMARY KEY,
    userID UUID REFERENCES users(id),
    videoID UUID REFERENCES videos(id),
    comment TEXT,
    createdAt TIMESTAMP
);



